{
  "manifest_version": 3,
  "name": "PadKey: Keyboard & Mouse Controller",
  "short_name": "PadKey",
  "version": "1.0.0",
  "description": "Play Xbox Cloud Gaming in Chrome with your keyboard and mouse. Adds a virtual controller, no gamepad needed.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "PadKey",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://play.xbox.com/*", "https://www.xbox.com/*/play*"],
      "js": ["src/inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://play.xbox.com/*", "https://www.xbox.com/*/play*"],
      "js": ["src/bridge.js"],
      "run_at": "document_start"
    }
  ],
  "homepage_url": "https://github.com/subscriptions-dot/xcloud-keyboard-gamepad",
  "minimum_chrome_version": "111"
}
